{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    // Mirrors vite.config.ts `resolve.alias`. This is what lets the editor
    // resolve `@/i18n/...`, `@/app/components/...`, etc. With
    // moduleResolution "bundler", `paths` needs no `baseUrl`.
    "paths": {
      "@/*": ["./src/*"]
    },

    // Ambient globals: Node for vite.config.ts, vite/client for `*.png` and
    // `import.meta.env`, and the Vitest + jest-dom globals used across the tests.
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", ".worktrees", "docs"]
}
